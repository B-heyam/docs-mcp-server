{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "wps-docs-mcp": {
        "type": "local",
        "command": [
          "node",
          "/absolute/path/to/docs-mcp-server/src/server.js"
        ],
        "environment": {
          "DOCS_DIR": "/absolute/path/to/your/documents/folder"
        },
        "disabled": false
      }
    }
  }
}
